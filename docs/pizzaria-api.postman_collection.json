{
  "info": {
    "name": "Pizzaria API",
    "description": "API REST da Pizzaria (JWT HS256). Rode na ordem: o login guarda o token na variável {{token}} e criar pedido guarda {{pedido_id}}. Documentação completa: api/openapi.yaml",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "token_outro",
      "value": ""
    },
    {
      "key": "pedido_id",
      "value": ""
    },
    {
      "key": "token_expirado",
      "value": "gere com: docker compose exec web php api/bin/gerar-token.php 1 -60"
    }
  ],
  "item": [
    {
      "name": "1. Sistema",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{base}}/health",
              "host": [
                "{{base}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
