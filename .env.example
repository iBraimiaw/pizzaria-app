# Copie este arquivo para .env e troque os valores.
# O .env NUNCA vai para o Git (está no .gitignore): ele guarda segredos.

APP_ENV=dev

# Endereço público do site (usado no link de "esqueci a senha")
APP_URL=http://localhost:8080

# Banco de dados
DB_NAME=pizzaria
DB_USER=pizzaria
DB_PASS=pizzaria123
DB_ROOT_PASS=root123

# Segredo para assinar tokens JWT da API.
# ATENÇÃO: este JWT_SECRET e a ENTREGA_SERVICE_KEY mais abaixo são PÚBLICOS
# (estão no Git) e só servem para dev.
# Com APP_ENV diferente de dev, a API e o microserviço se recusam a subir com
# eles ou com menos de 32 caracteres. Gere valores novos com: openssl rand -hex 32
JWT_SECRET=segredo-dev-troque-em-producao

# API REST: sites (origens) que podem chamar a API via fetch() no navegador.
# Vazio = nenhum site externo; * = qualquer um; ou uma lista separada por vírgula.
CORS_ORIGIN=http://localhost:3000

# Microserviço de entrega
ENTREGA_SERVICE_URL=http://entrega/
ENTREGA_SERVICE_KEY=chave-dev-entrega

# Coordenadas da pizzaria e raio máximo de entrega (usados pelo microserviço)
PIZZARIA_LAT=-20.4628
PIZZARIA_LNG=-54.6152
RAIO_MAXIMO_KM=15

# "Não sou um robô" (Google reCAPTCHA v2) no login, no cadastro e no esqueci a senha.
# Como ter as chaves: entre em https://www.google.com/recaptcha/admin e cadastre o site.
# Escolha reCAPTCHA v2, caixa de seleção "Não sou um robô" e o domínio localhost.
# Depois cole aqui as DUAS chaves que o Google mostrar, as duas do mesmo cadastro.
# Com só a chave do site, a secreta vira a de teste: a caixa aparece sem o
# aviso vermelho, mas o Google aprova qualquer resposta.
# Vazio = chaves de TESTE do Google. O quadradinho mostra um aviso vermelho e
# o Google aprova qualquer resposta. Servem só para dev: com APP_ENV diferente
# de dev, as páginas não abrem com elas.
# RECAPTCHA_ATIVO=0 desliga a verificação. É o plano B se faltar internet.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ATIVO=1
